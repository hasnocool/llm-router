# HuggingFace API token for the cloud provider (serverless Inference API router)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# Local llama.cpp server
LOCAL_BASE_URL=http://127.0.0.1:8081

# Google AI (Gemini) API key
GOOGLE_AI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cerebras API key (finite trial route by default)
CEREBRAS_API_KEY=csk_xxxxxxxxxxxxxxxxxxxxxxxx

# Groq API key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# NVIDIA NIM API key (finite trial route by default)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Zero-cost routing policy. Renewable direct APIs are preferred by default.
LLM_ROUTER_MIN_ZERO_COST_SCORE=60
LLM_ROUTER_INCLUDE_TRIALS=false
LLM_ROUTER_INCLUDE_CONDITIONAL=false
LLM_ROUTER_ALLOW_INDIRECT=false
LLM_ROUTER_ALLOW_SELF_HOST=false
LLM_ROUTER_ALLOW_DATA_IMPROVEMENT=false
LLM_ROUTER_REQUIRE_OPENAI_COMPATIBLE=false
# Local inference remains a fallback after renewable free API routes.
LLM_ROUTER_LOCAL_SCORE=76
# Small preference for the provider/model alias requested by the caller.
LLM_ROUTER_PRIMARY_BONUS=2.0

HOST=0.0.0.0
PORT=8000
