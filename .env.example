# .env.example
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
LOCAL_BASE_URL=http://127.0.0.1:8081
GOOGLE_AI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CEREBRAS_API_KEY=csk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional authentication for all /v1/* endpoints. Strongly recommended when
# HOST is not loopback.
ROUTER_API_KEY=

LLM_ROUTER_MIN_ZERO_COST_SCORE=55
LLM_ROUTER_INCLUDE_TRIALS=true
LLM_ROUTER_INCLUDE_CONDITIONAL=false
LLM_ROUTER_ALLOW_INDIRECT=false
LLM_ROUTER_ALLOW_SELF_HOST=false
LLM_ROUTER_ALLOW_DATA_IMPROVEMENT=true
LLM_ROUTER_REQUIRE_OPENAI_COMPATIBLE=false
LLM_ROUTER_LOCAL_SCORE=76
LLM_ROUTER_PRIMARY_BONUS=2.0

HOST=0.0.0.0
PORT=8000

# Logging (see [logs] in config.toml; these override defaults)
LLM_ROUTER_LOG_LEVEL=INFO
LLM_ROUTER_LOG_MESSAGE_BODIES=true
